# 复制成 .staging.env（gitignored）后填值。同名环境变量优先于这个文件。
# 用法见 scripts/staging-run.mjs 与 README 的 Staging 一节。

# staging backend 的地址，例如 https://meridian-backend-staging.swj299792458.workers.dev
# 来源：部署 meridian-backend-staging 后 wrangler 打印的 URL
STAGING_BACKEND_URL=

# staging backend 的后台 token（与生产不同）
# 来源：部署时 `wrangler secret put API_TOKEN --env staging` 放进去的那个值
STAGING_API_TOKEN=

# Neon `staging` 分支的连接串，只用来跑 migrate（脚本不打印它）
# 来源：Neon 控制台 → 项目 → Branches → staging → Connection string
STAGING_DATABASE_URL=

# staging 读者页（Pages preview 分支 `staging`）的地址，用来打印运行详情与读者页链接
# 来源：Cloudflare Pages 项目 → Deployments → Preview 分支 staging 的 URL
STAGING_READER_URL=

# Neon 项目 id，`neonctl branches reset` 用
# 来源：Neon 控制台 → 项目 Settings → General，或 `neonctl projects list`
NEON_PROJECT_ID=
