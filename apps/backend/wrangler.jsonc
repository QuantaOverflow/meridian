/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meridian-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "new_sqlite_classes": ["SourceScraperDO"],
      "tag": "v1",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "SourceScraperDO",
        "name": "SOURCE_SCRAPER",
      },
    ],
  },
  "observability": {
    "enabled": true,
  },
  /**
   * Cron 触发器 — 每日简报
   * UTC 13:00 = 北京时间 21:00。单次端到端实测 664-897 秒,约 21:15 前完成。
   * handler 见 src/index.ts 的 scheduled(),实现在 src/lib/scheduled/daily-brief.ts
   */
  "triggers": {
    "crons": ["0 13 * * *"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7e8763d05a974473a3d371f7544593ce",
      "localConnectionString": "postgresql://shiwenjie:dev@localhost:5432/meridian_local",
    },
  ],
  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  "placement": { "mode": "smart" },
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  "queues": {
    "producers": [
      {
        "queue": "meridian-article-processing-queue-prod",
        "binding": "ARTICLE_PROCESSING_QUEUE",
      },
    ],
    "consumers": [
      {
        "queue": "meridian-article-processing-queue-prod",
        "max_batch_size": 100,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "dead_letter_queue": "meridian-article-processing-dlq",
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "ARTICLES_BUCKET",
      "bucket_name": "meridian-articles-prod",
      // 本地 wrangler dev 直连线上桶（remote binding，需 wrangler >= 4.37）。
      // preview_bucket_name 一并去掉：它优先于 bucket_name 生效，会把 dev 指向空的
      // meridian-articles-dev；文章正文只在 prod 桶里。
      "remote": true,
    },
  ],
  /**
   * Browser Run（原 Browser Rendering）：抓取降级到浏览器时调 env.BROWSER.quickAction('content')。
   * quickAction 要求 compatibility_date >= 2026-03-24，且没有本地模拟：remote 让本地 wrangler dev
   * 也打真实 Browser Run，会产生真实用量。
   */
  "browser": {
    "binding": "BROWSER",
    "remote": true,
  },
  "workflows": [
    {
      "name": "meridian_process_articles",
      "binding": "PROCESS_ARTICLES",
      "class_name": "ProcessArticles",
    },
    {
      "name": "auto_brief_generation",
      "binding": "AUTO_BRIEF",
      "class_name": "AutoBriefGenerationWorkflow",
    },
  ],
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  "services": [
    {
      "binding": "AI_WORKER",
      "service": "meridian-ai-worker"
    },
    // ml-service 的 Worker（前面挂 Container）。本地 dev 没有 Container：加
    // `-c services/meridian-ml-service/dev-shim/wrangler.jsonc`，由它转发到本机 uvicorn。
    {
      "binding": "ML_SERVICE",
      "service": "meridian-ml-service"
    }
  ]
}
