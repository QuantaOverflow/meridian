/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meridian-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  // 声明 Worker 读的 secret 名（值用 wrangler secret put，不入库）。`wrangler types` 只按这里生成
  // Env 的 secret 字段，不再从各人本地的 .dev.vars 推断，生成结果在每台机器上一致；
  // deploy 时缺这个 secret 会直接报错。
  "secrets": {
    // CF_ANALYTICS_TOKEN：运维台读账户用量（Account Analytics: Read），由账户所有者在 dashboard 建
    "required": ["API_TOKEN", "CF_ANALYTICS_TOKEN"],
  },
  // 运维台读 Cloudflare GraphQL Analytics 用（src/lib/ops/cloudflare.ts）。CF_API_BASE_URL 单列成变量是为了测试能指到假服务
  "vars": {
    "CF_ACCOUNT_ID": "c8317cfcb330d45b37b00ccd7e8a9936",
    "CF_API_BASE_URL": "https://api.cloudflare.com/client/v4",
    // 跑在哪个环境："production"（顶层）或 "staging"（env.staging）。两边取值由 scripts/check-staging-isolation.mjs 断言
    "ENVIRONMENT": "production",
  },
  "migrations": [
    {
      "new_sqlite_classes": ["SourceScraperDO"],
      "tag": "v1",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "SourceScraperDO",
        "name": "SOURCE_SCRAPER",
      },
    ],
  },
  // 日志与 trace 全量（采样率 1）：每天 1 期简报、每源每小时 1 次 alarm，调用量小，
  // 采样会丢掉最需要看的那一期。取值与用量/费用依据见根 README「Monitoring」的 Logs & traces。
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  /**
   * Cron 触发器 — 每日简报
   * UTC 13:00 = 北京时间 21:00。单次端到端实测 664-897 秒,约 21:15 前完成。
   * handler 见 src/index.ts 的 scheduled(),实现在 src/lib/scheduled/daily-brief.ts
   */
  "triggers": {
    "crons": ["0 13 * * *"],
  },
  // 本次部署的版本 id 与时刻，运维台读（GET /observability/ops/services）（提交哈希与标题由 scripts/deploy.sh 用 --var 注入）
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7e8763d05a974473a3d371f7544593ce",
      "localConnectionString": "postgresql://shiwenjie:dev@localhost:5432/meridian_local",
    },
  ],
  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  "placement": { "mode": "smart" },
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  "queues": {
    "producers": [
      {
        "queue": "meridian-article-processing-queue-prod",
        "binding": "ARTICLE_PROCESSING_QUEUE",
      },
    ],
    "consumers": [
      {
        "queue": "meridian-article-processing-queue-prod",
        "max_batch_size": 100,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "dead_letter_queue": "meridian-article-processing-dlq",
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "ARTICLES_BUCKET",
      "bucket_name": "meridian-articles-prod",
      // 本地 wrangler dev 直连线上桶（remote binding，需 wrangler >= 4.37）。
      // preview_bucket_name 一并去掉：它优先于 bucket_name 生效，会把 dev 指向空的
      // meridian-articles-dev；文章正文只在 prod 桶里。
      "remote": true,
    },
  ],
  /**
   * Browser Run（原 Browser Rendering）：抓取降级到浏览器时调 env.BROWSER.quickAction('content')。
   * quickAction 要求 compatibility_date >= 2026-03-24，且没有本地模拟：remote 让本地 wrangler dev
   * 也打真实 Browser Run，会产生真实用量。
   */
  "browser": {
    "binding": "BROWSER",
    "remote": true,
  },
  "workflows": [
    {
      "name": "meridian_process_articles",
      "binding": "PROCESS_ARTICLES",
      "class_name": "ProcessArticles",
    },
    {
      "name": "auto_brief_generation",
      "binding": "AUTO_BRIEF",
      "class_name": "AutoBriefGenerationWorkflow",
    },
  ],
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  "services": [
    {
      "binding": "AI_WORKER",
      "service": "meridian-ai-worker"
    },
    // ml-service 的 Worker（前面挂 Container）。本地 dev 没有 Container：加
    // `-c services/meridian-ml-service/dev-shim/wrangler.jsonc`，由它转发到本机 uvicorn。
    {
      "binding": "ML_SERVICE",
      "service": "meridian-ml-service"
    }
  ],
  /**
   * Staging 环境（ADR 0013）：`../../scripts/deploy.sh --env staging` 部署成 meridian-backend-staging。
   * binding 与 vars 不从顶层继承，这里每一项都要自己写；漏写是 undefined 报错，不会落到生产。
   * 会漏到生产的只有把生产的资源名 / id 抄进来——scripts/check-staging-isolation.mjs 拦这个
   * （唯一的白名单是 ML_SERVICE：ml-service 不存数据，staging 共用生产那份）。
   * observability、placement、migrations、compatibility_* 从顶层继承；secrets 不继承。
   */
  "env": {
    "staging": {
      // secret 要单独放一遍：wrangler secret put API_TOKEN --env staging（值与生产不同）
      "secrets": { "required": ["API_TOKEN", "CF_ANALYTICS_TOKEN"] },
      "vars": {
        "CF_ACCOUNT_ID": "c8317cfcb330d45b37b00ccd7e8a9936",
        "CF_API_BASE_URL": "https://api.cloudflare.com/client/v4",
        "ENVIRONMENT": "staging",
      },
      // staging 不定时触发：只由 scripts/staging-run.sh（或手动运行入口）起
      "triggers": { "crons": [] },
      "durable_objects": {
        "bindings": [{ "class_name": "SourceScraperDO", "name": "SOURCE_SCRAPER" }],
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          // meridian-staging → Neon 分支 staging（每次 Staging 运行前 reset 到 production）
          "id": "c2de49c847a54a6b8d390411f6359173",
          "localConnectionString": "postgresql://shiwenjie:dev@localhost:5432/meridian_local",
        },
      ],
      "queues": {
        "producers": [{ "queue": "meridian-article-processing-queue-staging", "binding": "ARTICLE_PROCESSING_QUEUE" }],
        "consumers": [
          {
            "queue": "meridian-article-processing-queue-staging",
            "max_batch_size": 100,
            "max_batch_timeout": 30,
            "max_retries": 5,
            "dead_letter_queue": "meridian-article-processing-dlq-staging",
          },
        ],
      },
      "r2_buckets": [{ "binding": "ARTICLES_BUCKET", "bucket_name": "meridian-articles-staging" }],
      "browser": { "binding": "BROWSER" },
      "workflows": [
        { "name": "meridian_process_articles_staging", "binding": "PROCESS_ARTICLES", "class_name": "ProcessArticles" },
        { "name": "auto_brief_generation_staging", "binding": "AUTO_BRIEF", "class_name": "AutoBriefGenerationWorkflow" },
      ],
      "services": [
        { "binding": "AI_WORKER", "service": "meridian-ai-worker-staging" },
        { "binding": "ML_SERVICE", "service": "meridian-ml-service" },
      ],
    },
  },
}
