{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  "workspaces": {
    ".": {
      "entry": ["scripts/knowledge/*.ts"],
      "project": ["scripts/knowledge/**/*.ts"]
    },

    "apps/backend": {
      "entry": ["src/workflows/*.ts", "src/durable_objects/*.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    },

    "apps/frontend": {
      "entry": [
        "src/pages/**/*.vue",
        "src/layouts/*.vue",
        "src/server/**/*.ts"
      ],
      "project": ["src/**/*.{ts,vue}"],
      "ignoreDependencies": ["@unhead/vue", "vue-router", "vue-tsc", "wrangler"]
    },

    "services/meridian-ai-worker": {
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["jq"]
    },

    "packages/database": {
      "project": ["src/**/*.ts"]
    },

    "eval/*": {
      "entry": ["**/*.{ts,mjs}"],
      "project": ["**/*.{ts,mjs}"]
    },

    "eval/cluster-to-brief": {
      "entry": ["**/*.{ts,mjs}"],
      "project": ["**/*.{ts,mjs}"],
      "ignoreBinaries": ["wrangler"]
    }
  },

  "ignoreWorkspaces": [
    "apps/*/prototypes/*",
    "services/*/prototypes/*",
    "services/meridian-ml-service/cf-worker"
  ],

  "ignore": ["**/prototypes/**"],

  "ignoreIssues": {
    "eval/cluster-to-brief/lib.mjs": ["duplicates"]
  }
}
