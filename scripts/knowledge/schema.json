{
  "version": 2,
  "entities": {
    "goal": { "label": "目标与约束", "required": ["criteria"] },
    "attempt": { "label": "尝试与方案", "required": ["hypothesis", "changes", "reason", "next_unknown"] },
    "experiment": {
      "label": "实验与分析记录",
      "required": ["kind", "outcome", "inputs", "evaluation", "result", "cost", "record_completeness"]
    },
    "lesson": { "label": "经验与观察", "required": ["kind", "invalidates_when"] },
    "mechanism": { "label": "可复用机制与方法", "required": ["input", "output", "limits", "invalidates_when"] },
    "decision": { "label": "决定", "required": ["action", "invalidates_when"] }
  },
  "relations": {
    "addresses": { "from": ["attempt"], "to": ["goal"], "label": "解决目标" },
    "varies_from": {
      "from": ["attempt"],
      "to": ["attempt"],
      "label": "改变旧尝试",
      "required_attributes": ["changed", "reason"]
    },
    "evaluated_by": { "from": ["attempt"], "to": ["experiment"], "label": "由实验验证" },
    "yields": { "from": ["experiment"], "to": ["lesson"], "label": "形成经验" },
    "motivates": { "from": ["lesson"], "to": ["attempt"], "label": "引出新尝试" },
    "contains": { "from": ["attempt"], "to": ["mechanism"], "label": "包含机制" },
    "justified_by": { "from": ["mechanism"], "to": ["lesson"], "label": "保留依据" },
    "incorporates": {
      "from": ["attempt"],
      "to": ["mechanism"],
      "label": "融合机制",
      "required_attributes": ["adaptation"]
    },
    "based_on": {
      "from": ["goal", "attempt", "lesson", "mechanism", "decision"],
      "to": ["experiment", "lesson"],
      "label": "依据"
    },
    "supersedes": {
      "from": ["decision", "lesson", "attempt"],
      "to": ["decision", "lesson", "attempt"],
      "label": "取代",
      "same_type": true
    },
    "constrained_by": {
      "from": ["attempt", "experiment", "lesson", "mechanism", "decision"],
      "to": ["goal"],
      "label": "受约束"
    },
    "requires": {
      "from": ["goal", "attempt", "experiment", "lesson", "mechanism", "decision"],
      "to": ["mechanism"],
      "label": "依赖机制或方法"
    },
    "supports": {
      "from": ["lesson"],
      "to": ["lesson", "attempt"],
      "label": "条件性支持",
      "required_attributes": ["scope"]
    },
    "cautions": {
      "from": ["lesson"],
      "to": ["lesson", "attempt", "mechanism"],
      "label": "适用范围内的警示",
      "required_attributes": ["scope"]
    },
    "selects": {
      "from": ["decision"],
      "to": ["attempt", "mechanism"],
      "label": "选择或暂缓",
      "required_attributes": ["action"]
    }
  }
}
