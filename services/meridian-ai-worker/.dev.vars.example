# 本地开发：复制本文件为 .dev.vars 并填值（.dev.vars 已 gitignored）
# 生产：在本目录用 `wrangler secret put <NAME>`（标 🔐 的）
# 注：旧的 .env.example 已与实际脱节，以本文件为准。

# --- Cloudflare AI Gateway（所有 LLM 都走它）---
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_GATEWAY_ID=meridian-ai
AI_GATEWAY_TOKEN=your_ai_gateway_token          # 🔐 仅 AI Gateway 启用鉴权时需要

# --- DashScope (Qwen) — 必填，所有阶段 LLM 都用它 ---
DASHSCOPE_API_KEY=your_dashscope_key            # 🔐 sk-...

# --- 其他 provider key（不用就留 placeholder）---
GOOGLE_AI_API_KEY=placeholder
OPENAI_API_KEY=placeholder
ANTHROPIC_API_KEY=placeholder
CLOUDFLARE_API_TOKEN=placeholder                # 🔐

# --- Gateway 鉴权 / 运行配置 ---
GATEWAY_API_KEYS=dev-local-token                # 🔐 逗号分隔
ENVIRONMENT=development
LOG_LEVEL=info
ENABLE_MOCK_PROVIDERS=false
