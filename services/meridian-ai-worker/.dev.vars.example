# 本地开发：复制本文件为 .dev.vars 并填值（.dev.vars 已 gitignored）
# 生产：在本目录用 `wrangler secret put <NAME>`（标 🔐 的）
# Workers AI 走 wrangler.toml 的 [ai] binding，不需要任何 key；简报链路与文章分析全走它。

# --- Cloudflare AI Gateway（只有 dashscope 走它）---
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_GATEWAY_ID=meridian-ai
AI_GATEWAY_TOKEN=your_ai_gateway_token          # 🔐 仅 AI Gateway 启用鉴权时需要

# --- DashScope (Qwen) — 可选，只有 /meridian/chat 不传 provider 时默认用它 ---
DASHSCOPE_API_KEY=your_dashscope_key            # 🔐 sk-...

# --- 运行配置 ---
ENVIRONMENT=development
LOG_LEVEL=info
