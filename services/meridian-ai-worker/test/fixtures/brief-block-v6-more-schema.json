{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "reason",
    "title",
    "sentences"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "written",
        "not_a_single_event"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "sentences": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "sources"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 400
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "articleId",
                "sentence"
              ],
              "properties": {
                "articleId": {
                  "type": "integer"
                },
                "sentence": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  }
}
