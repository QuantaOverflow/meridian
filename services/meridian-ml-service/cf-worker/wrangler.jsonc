{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meridian-ml-service",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "MeridianMLContainer",
      "image": "../Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ML_CONTAINER",
        "class_name": "MeridianMLContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MeridianMLContainer"]
    }
  ]
}
